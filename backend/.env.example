# =============================================================================
# Backend Service - Статьи и комментарии
# =============================================================================

# Окружение
NODE_ENV=development
PORT=3000

# База данных (db-main)
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app_main

# JWT секрет (должен совпадать с users-api!)
JWT_SECRET=your-secret-key-change-in-production
