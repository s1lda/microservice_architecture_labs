# =============================================================================
# Users API Service - Пользователи и аутентификация
# =============================================================================

# Окружение
NODE_ENV=development
PORT=3000

# База данных (db-users)
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app_users

# JWT секрет (должен совпадать с backend!)
JWT_SECRET=your-secret-key-change-in-production
